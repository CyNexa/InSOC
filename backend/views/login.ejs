<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>InSOC - Login</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="stylesheet" href="/css/styles.css" />
  <link rel="stylesheet" href="/css/extra.css" />
  <link rel="shortcut icon" href="favicon.png" type="image/x-icon">
</head>
<body class="min-h-screen bg-slate-950 flex items-center justify-center px-4">
  <div class="w-full max-w-sm rounded-2xl border border-slate-800 bg-slate-900/80 shadow-xl p-6 space-y-4">
    <div class="flex items-center gap-3">
      <div class="w-9 h-9 rounded-xl bg-indigo-500 flex items-center justify-center text-xs font-bold">
        <img style="width: 20px; height: 20px;" src="favicon.png" alt="Icon">
      </div>
      <div>
        <h1 class="text-lg font-semibold text-slate-50">InSOC Login</h1>
        <p class="text-xs text-slate-400 mt-0.5">Secure access to monitoring dashboard.</p>
      </div>
    </div>

    <% if (error) { %>
      <div class="rounded-lg border border-red-500/40 bg-red-500/10 px-3 py-2 text-xs text-red-200">
        <%= error %>
      </div>
    <% } %>

    <form method="POST" action="/login" class="space-y-3">
      <div class="space-y-1">
        <label class="block text-xs font-medium text-slate-300">Username</label>
        <input
          type="text"
          name="username"
          required
          class="w-full rounded-md border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-slate-100 outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500"
        />
      </div>

      <div class="space-y-1">
        <label class="block text-xs font-medium text-slate-300">Password</label>
        <input
          type="password"
          name="password"
          required
          class="w-full rounded-md border border-slate-700 bg-slate-950 px-3 py-2 text-sm text-slate-100 outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500"
        />
      </div>

      <button
        type="submit"
        class="w-full mt-2 inline-flex items-center justify-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500 transition shadow-sm"
      >
        Sign in
      </button>
    </form>

    <p class="text-[11px] text-slate-500 text-center">
      Demo Credentials are Included in the Documentation.
    </p>
  </div>
</body>
</html>
