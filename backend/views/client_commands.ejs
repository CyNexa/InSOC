<%- include('layout', {
  title: 'Client Commands',
  user: user,
  body: `
  <section class="space-y-6">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3">
      <div>
        <h1 class="text-2xl font-semibold text-slate-50">Client Command History</h1>
        <p class="text-sm text-slate-400 mt-1">
          Commands captured from monitored client bash histories.
        </p>
      </div>
      <div class="text-xs text-slate-500">
        Latest 200 entries. Use to trace suspicious behaviour.
      </div>
    </div>

    <div class="rounded-xl border border-slate-800 bg-slate-900/70">
      <div class="flex items-center justify-between px-4 py-3 border-b border-slate-800">
        <h2 class="text-sm font-medium text-slate-100">Client Commands</h2>
      </div>

      <div class="overflow-x-auto">
        <div class="scroll-y">
          <table class="min-w-full text-sm text-left">
            <thead class="bg-slate-900/90">
              <tr class="border-b border-slate-800 text-xs text-slate-400">
                <th class="px-3 py-2 whitespace-nowrap">Time (IST)</th>
                <th class="px-3 py-2 whitespace-nowrap">Host</th>
                <th class="px-3 py-2 whitespace-nowrap">User</th>
                <th class="px-3 py-2">Command</th>
                <th class="px-3 py-2 whitespace-nowrap">Severity</th>
              </tr>
            </thead>
            <tbody id="client-commands-body" class="divide-y divide-slate-800">
              ${
                commands
                  .map(c => {
                    const t = toISTString(c.timestamp);
                    const sevClass =
                      c.severity === 'HIGH'   ? 'bg-red-500/20 text-red-200 border border-red-500/40' :
                      c.severity === 'MEDIUM' ? 'bg-amber-500/20 text-amber-100 border border-amber-500/40' :
                      c.severity === 'LOW'    ? 'bg-sky-500/20 text-sky-100 border border-sky-500/40' :
                                                'bg-slate-800 text-slate-200 border border-slate-700/60';

                    return `
                      <tr class="hover:bg-slate-800/70 transition-colors">
                        <td class="px-3 py-2 text-xs text-slate-300 whitespace-nowrap">${t}</td>
                        <td class="px-3 py-2 text-xs text-slate-300 whitespace-nowrap">${c.host || ""}</td>
                        <td class="px-3 py-2 text-xs text-slate-300 whitespace-nowrap">${c.user || ""}</td>
                        <td class="px-3 py-2 text-xs text-slate-100">
                          <code class="text-[11px] bg-slate-950/60 px-2 py-1 rounded border border-slate-800 block whitespace-pre-wrap">${c.command}</code>
                        </td>
                        <td class="px-3 py-2 whitespace-nowrap">
                          ${
                            c.severity
                              ? `<span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-[11px] font-medium ${sevClass}">${c.severity}</span>`
                              : ''
                          }
                        </td>
                      </tr>
                    `;
                  })
                  .join("")
              }
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <script src="/js/commands.js"></script>
  `
}) %>
